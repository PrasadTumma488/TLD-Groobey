# Copy to .env and fill values. Never commit real secrets.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Required for owner/staff admin server actions (create user, etc.). Must be non-empty:
# Dashboard → Project Settings → API → service_role (secret), one line, no spaces around =.
# Must be the secret service_role key (sb_secret_… or legacy JWT), NOT sb_publishable_… (that is the anon key and cannot write user_roles).
# Local: npm run env:service-role -- YOUR_KEY_HERE
# Vercel Production (tldgroobey.in): npm run env:vercel-service-role  — then redeploy. Verify: npm run env:vercel-check
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres migrations (npm run db:push). Dashboard → Project Settings → Database → password.
# Also add to Vercel Production so the server can auto-apply schema (out-of-stock, combos, etc.).
SUPABASE_DB_PASSWORD=

# Optional: bootstrap platform admin. Server reads these at runtime from process.env and from .env in the project root (see src/lib/platform-admin-bootstrap.server.ts). Needs SUPABASE_SERVICE_ROLE_KEY. Vercel: Project → Settings → Environment Variables. Fallback: supabase/grant_platform_admin.sql in SQL Editor.
# Example: PLATFORM_ADMIN_EMAILS=you@company.com,other@company.com
PLATFORM_ADMIN_EMAILS=

# Optional: same as emails but by Auth user UUID (comma-separated). Requires SUPABASE_SERVICE_ROLE_KEY. Example: PLATFORM_ADMIN_USER_IDS=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PLATFORM_ADMIN_USER_IDS=

# Required on Vercel (Production + Preview). Also set SUPABASE_* below for server actions.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Production site URL (used for SEO canonical URLs, sitemap, and Supabase Auth redirects):
# Example: https://tldgroobey.in
SITE_URL=
# Optional client-visible alias (same value as SITE_URL):
VITE_SITE_URL=

# Optional Google Analytics 4 (view-source gtag.js — same pattern as instructiq.in):
# GROOBEY_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console (DNS TXT at your domain registrar, if using domain verification):
# Name: @   Type: TXT   Value: google-site-verification=kvy-uAjz9f6iFiDr4ZWlUZ32Ze0FCSwC5t7f796nr8Q
# HTML meta tag is already in the site head (src/routes/__root.tsx).

# Production site URL (Supabase Auth → URL Configuration → Site URL + Redirect URLs must include this):
# Example: https://tldgroobey.in and https://www.tldgroobey.in
#
# Vercel: this app is TanStack Start + Nitro (see vite.config.ts). Do NOT set Output Directory to
# dist in the Vercel project - the build writes .vercel/output automatically. Redeploy after env changes.

# Resend: API key must stay server-only (RESEND_API_KEY - never VITE_*). The "From" address is not secret;
# prefer RESEND_FROM_EMAIL; optional fallback VITE_RESEND_FROM_EMAIL is read on the server at runtime too.
RESEND_API_KEY=
#
# Customer bills (local OR deployed): Resend treats onboarding@resend.dev as "test mode" - it will not
# deliver To arbitrary addresses. Same rules as production: verify a domain at resend.com/domains, then
# set RESEND_FROM_EMAIL below to an address on that domain. After editing .env, restart `npm run dev`.
#
# REQUIRED for customer bill emails to reach arbitrary customer inboxes:
# 1) In Resend: https://resend.com/domains - add DNS records until the domain shows "Verified".
# 2) In Resend: Domains → your domain → copy the suggested "From" address (e.g. onboarding@yourdomain.com or your chosen local part).
# 3) On Vercel: Project → Settings → Environment Variables → Add:
#      Name:  RESEND_FROM_EMAIL
#      Value: Groobey <bills@yourdomain.com>   (use YOUR verified address; quotes optional in the UI)
#    Also set RESEND_API_KEY (same screen). Scope: Production (and Deploy previews if you test there).
# 4) Redeploy (Deployments → … → Redeploy). Env vars apply only to new deployments.
# 5) Local dev: put the same lines in .env in the project root and restart `npm run dev`.
#
# Optional aliases (if you already use these names elsewhere):
# RESEND_MAIL_FROM=bills@yourdomain.com
# EMAIL_FROM=bills@yourdomain.com
# Optional: same as RESEND_FROM_EMAIL but Vite-exposed name (still read only on the server for mail - never for the API key):
# VITE_RESEND_FROM_EMAIL=bills@yourdomain.com
RESEND_FROM_EMAIL=
# Optional: non-bill notifications in dev only - customer bills do not use this as the recipient.
RESEND_REDIRECT_TO=
